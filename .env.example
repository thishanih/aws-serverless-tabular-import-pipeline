# Reference values for local development. Export these in your shell or load them with Node's --env-file option.
PORT=3000
CORS_ORIGIN=http://localhost:5173
UPLOADS_BUCKET=your-deployed-upload-bucket-name

# Optional: use a profile configured with the AWS CLI.
AWS_PROFILE=default

# Alternative: temporary credentials. Keep real values in your ignored .env file only.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Lambda runtime values supplied by the CDK stack during deployment.
JOBS_TABLE=created-by-cdk
ERRORS_TABLE=created-by-cdk
RECORDS_TABLE=created-by-cdk
CHUNK_SUMMARIES_TABLE=created-by-cdk
REPORTS_BUCKET=created-by-cdk
VALIDATION_QUEUE_URL=created-by-cdk
RECORDS_QUEUE_URL=created-by-cdk
STATE_MACHINE_ARN=created-by-cdk
NOTIFICATION_EMAIL=recipient@example.com
SES_FROM_EMAIL=verified-sender@example.com